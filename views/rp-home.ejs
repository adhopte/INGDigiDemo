<%- include('partials/header') %>
<section class="hero">
  <h1><%= rp.displayName %></h1>
  <p><%= rp.tagline %></p>
</section>
<section class="panel">
  <h2>Wallet connection test <span class="badge">temporary – replaced by the use-case flow</span></h2>
  <dl class="meta">
    <dt>OIDC client_id</dt><dd><code><%= rp.clientId %></code></dd>
    <dt>Redirect URI</dt><dd><code><%= redirectUri %></code></dd>
  </dl>
  <div class="actions">
    <% Object.entries(rp.presentations).forEach(function (e) { %>
      <a class="btn" href="<%= basePath %>/auth/start?p=<%= e[0] %>&returnTo=<%= encodeURIComponent(basePath + '/') %>">Present: <%= e[1].label %></a>
    <% }) %>
  </div>
  <% Object.entries(disclosed).forEach(function (e) { %>
    <h3>Disclosed (<%= e[0] %>)<% if (e[1].mock) { %> <span class="badge">MOCK DATA</span><% } %></h3>
    <table class="claims">
      <% Object.entries(e[1].claims).forEach(function (c) { %>
        <tr><th><%= c[0] %></th><td><%= typeof c[1] === 'object' ? JSON.stringify(c[1]) : c[1] %></td></tr>
      <% }) %>
    </table>
    <% if (e[1].missing.length) { %><p class="warn">Missing expected claims: <%= e[1].missing.join(', ') %></p><% } %>
  <% }) %>
</section>
<%- include('partials/footer') %>
