<%- include('partials/head') %>
<div class="wrap narrow">
  <% if (typeof rp === 'undefined' || !rp) { %><%- include('partials/flow-steps', { current: 3, steps: [t('portal.steps.usecase'), t('portal.steps.record'), t('portal.steps.offer')] }) %>
  <% } %>
  <h1><%= t('offer.title', { name: t('att.' + attestationKey + '.name') }) %></h1>
  <p class="lead"><%= t('offer.intro') %></p>

  <section class="panel handoff" aria-labelledby="offer-h">
    <h2 id="offer-h"><%= t('offer.get') %></h2>
    <div class="handoff-grid">
      <div class="handoff-mobile">
        <p><%= t('offer.mobile') %></p>
        <p><a class="btn btn-large" href="<%= offer.deeplink %>"><%= t('offer.open_wallet') %></a></p>
      </div>
      <div class="handoff-desktop">
        <p><%= t('offer.desktop') %></p>
        <img class="qr qr-wide" id="offer-qr" src="<%= offer.qr %>" width="360" height="360" alt="<%= t('offer.qr_alt', { name: t('att.' + attestationKey + '.name') }) %>">
        <p><button type="button" class="btn btn-secondary btn-small" data-qr-zoom="offer-qr" data-close="<%= t('qr.close') %>" hidden><%= t('qr.enlarge') %></button></p>
      </div>
    </div>
    <% if (offer.txCode) { %>
      <p class="alert alert-info" role="note"><%= t('offer.txcode') %> <strong class="txcode"><%= offer.txCode %></strong></p>
    <% } %>
    <% if (offer.authorizationCode) { %>
      <p class="note"><%= t('offer.authcode') %> <code class="break"><%= offer.authorizationCode %></code></p>
    <% } %>
    <details class="raw">
      <summary><%= t('verify.show_link') %></summary>
      <p><code class="break" id="deeplink-text"><%= offer.deeplink %></code></p>
      <p><button type="button" class="btn btn-small btn-secondary" data-copy="deeplink-text" data-done="<%= t('offer.copied') %>" hidden><%= t('offer.copy') %></button></p>
    </details>
    <p class="note"><%= t('offer.expires', { time: new Intl.DateTimeFormat(locale, { timeStyle: 'short' }).format(offer.expiresAt) }) %></p>
  </section>

  <% if (canSimulate) { %>
  <section class="panel panel-mock" aria-labelledby="sim-h">
    <h2 id="sim-h"><%= t('mockw.badge') %></h2>
    <p><%= t('offer.sim_intro') %></p>
    <form method="post" action="/wallet-sim/redeem">
      <input type="hidden" name="offerId" value="<%= offer.id %>">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <% if (offer.txCode) { %><input type="hidden" name="txCode" value="<%= offer.txCode %>"><% } %>
      <button class="btn btn-secondary" type="submit"><%= t('offer.sim_btn') %></button>
    </form>
  </section>
  <% } %>

  <p><a class="btn btn-secondary" href="<%= returnTo %>"><%= t('btn.back') %></a></p>
</div>
<script src="/js/copy.js?v=<%= v %>" defer></script>
<script src="/js/qr-zoom.js?v=<%= v %>" defer></script>
<%- include('partials/foot') %>
