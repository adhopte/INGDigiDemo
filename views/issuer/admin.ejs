<%- include('../partials/head') %>
<% const L = function (n) { const k = 'claim.' + n; const v = t(k); return v === k ? n.replace(/_/g, ' ') : v; }; %>
<div class="wrap">
  <p class="crumbs"><a href="/demo-issuer"><%= t('portal.title') %></a> › <%= t('admin.title') %></p>
  <div class="admin-head">
    <h1><%= t('admin.title') %></h1>
    <form method="post" action="/demo-issuer/admin/logout"><button class="btn btn-small btn-secondary" type="submit"><%= t('admin.logout') %></button></form>
  </div>
  <p class="lead"><%= t('admin.intro') %></p>

  <nav aria-label="<%= t('portal.select.label') %>">
    <ul class="chips">
      <li><a class="chip<%= uc === 'pid' ? ' chip-ok' : '' %>" href="/demo-issuer/admin?uc=pid"<%= uc === 'pid' ? ' aria-current="page"' : '' %>><%= t('att.pid.name') %></a></li>
      <li><a class="chip<%= uc === 'birth-certificate' ? ' chip-ok' : '' %>" href="/demo-issuer/admin?uc=birth-certificate"<%= uc === 'birth-certificate' ? ' aria-current="page"' : '' %>><%= t('att.birth_certificate.name') %></a></li>
    </ul>
  </nav>

    <% if (Object.keys(errors).length) { %>
    <div class="alert alert-error" role="alert">
      <p><strong><%= t('form.err.summary') %></strong></p>
      <ul><% Object.keys(errors).forEach(function (k) { %><li><a href="#f-<%= k %>"><%= L(k) %>: <%= t(errors[k]) %></a></li><% }) %></ul>
    </div>
  <% } %>

  <section class="panel titled" aria-labelledby="rec-h">
    <h2 class="titlebar" id="rec-h"><%= t('admin.form.title') %></h2>
    <p class="note"><%= t('admin.form.hint') %></p>
    <form method="post" action="/demo-issuer/admin/check" novalidate>
      <input type="hidden" name="uc" value="<%= uc %>">
      <div class="admin-fields">
        <% fields.forEach(function (f) { const val = values[f.name] === undefined ? '' : values[f.name]; const err = errors[f.name]; %>
        <div class="field<%= err ? ' has-error' : '' %>">
          <label for="f-<%= f.name %>"><%= L(f.name) %><% if (f.required) { %> <span aria-hidden="true">*</span><% } %></label>
          <% if (f.kind === 'gender') { %>
            <select id="f-<%= f.name %>" name="<%= f.name %>"<% if (err) { %> aria-invalid="true" aria-describedby="e-<%= f.name %>"<% } %>>
              <option value=""><%= t('admin.none') %></option>
              <% ['1','2','0','9'].forEach(function (g) { %><option value="<%= g %>"<%= val === g ? ' selected' : '' %>><%= t('admin.gender.' + g) %></option><% }) %>
            </select>
          <% } else if (f.kind === 'boolean') { %>
            <select id="f-<%= f.name %>" name="<%= f.name %>"<% if (err) { %> aria-invalid="true" aria-describedby="e-<%= f.name %>"<% } %>>
              <option value=""><%= t('admin.auto') %></option>
              <option value="True"<%= val === 'True' ? ' selected' : '' %>><%= t('admin.yes') %></option>
              <option value="False"<%= val === 'False' ? ' selected' : '' %>><%= t('admin.no') %></option>
            </select>
          <% } else { %>
            <input id="f-<%= f.name %>" name="<%= f.name %>" type="<%= f.kind === 'date' ? 'date' : 'text' %>" value="<%= val %>" maxlength="<%= f.max || 120 %>"<% if (f.kind !== 'date') { %> autocomplete="off"<% } %><% if (f.required) { %> required<% } %><% if (err) { %> aria-invalid="true" aria-describedby="e-<%= f.name %>"<% } %>>
          <% } %>
          <% if (err) { %><p class="field-error" id="e-<%= f.name %>"><%= t(err) %></p><% } %>
        </div>
        <% }) %>
      </div>
      <p><button class="btn btn-large" type="submit"><%= t('admin.create') %></button></p>
    </form>
  </section>

  <% if (!mockMode) { %><p class="alert alert-info" role="note"><%= t('admin.sigma_note') %></p><% } %>

  <section class="panel" aria-labelledby="reuse-h">
    <h2 id="reuse-h"><%= t('admin.reuse.title') %></h2>
    <p><%= t('admin.reuse.hint') %></p>
    <p><strong><%= reusePolicy === 'sigma' ? t('admin.reuse.current_on') : t('admin.reuse.current_off') %></strong></p>
    <form method="post" action="/demo-issuer/admin/reuse-policy">
      <input type="hidden" name="value" value="<%= reusePolicy === 'sigma' ? 'off' : 'sigma' %>">
      <button class="btn btn-secondary" type="submit"><%= reusePolicy === 'sigma' ? t('admin.reuse.turn_off') : t('admin.reuse.turn_on') %></button>
    </form>
  </section>

  <section class="panel" aria-labelledby="batch-h">
    <h2 id="batch-h"><%= t('admin.batch.title') %></h2>
    <p><%= t('admin.batch.hint') %></p>
    <p><strong><%= batchSize === 1 ? t('admin.batch.current_one') : t('admin.batch.current_n', { n: batchSize }) %></strong></p>
    <form method="post" action="/demo-issuer/admin/batch-size" class="portal-form">
      <div class="field">
        <label for="batch-value"><%= t('admin.batch.label') %></label>
        <select id="batch-value" name="value">
          <% [1, 2, 5, 10].forEach(function (n) { %><option value="<%= n %>"<%= n === batchSize ? ' selected' : '' %>><%= n === 1 ? t('admin.batch.option_one') : n %></option><% }) %>
        </select>
      </div>
      <button class="btn btn-secondary" type="submit"><%= t('admin.batch.apply') %></button>
    </form>
  </section>
</div>
<%- include('../partials/foot') %>
