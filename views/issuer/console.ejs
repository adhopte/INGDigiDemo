<%- include('../partials/head') %>
<div class="wrap narrow">
  <h1><%= t('issuer.console.title') %></h1>
  <p class="lead"><%= t('issuer.console.intro') %></p>
  <% types.forEach(function (type) { %>
  <section class="panel" aria-labelledby="t-<%= type %>">
    <h2 id="t-<%= type %>"><%= t('att.' + type + '.name') %></h2>
    <p><%= t('issuer.console.' + type) %></p>
    <form method="post" action="/demo-issuer/offer" class="inline-form">
      <input type="hidden" name="type" value="<%= type %>">
      <div class="field">
        <label for="persona-<%= type %>"><%= t('mockw.persona') %></label>
        <select id="persona-<%= type %>" name="persona">
          <% personas.forEach(function (p) { %><option value="<%= p.id %>"<% if (p.id === locales.find(function (l) { return l.code === locale; }).country) { %> selected<% } %>><%= p.given %> <%= p.family %> – <%= regionName(p.id) %></option><% }) %>
        </select>
      </div>
      <button class="btn" type="submit"><%= t('issuer.console.create') %></button>
    </form>
  </section>
  <% }) %>
  <% if (sigmaItems.length) { %>
  <section class="panel" aria-labelledby="sg-h">
    <h2 id="sg-h"><%= t('issuer.console.sigma_title') %></h2>
    <p><%= t('issuer.console.sigma_pid') %></p>
    <% sigmaItems.forEach(function (it) { %>
      <form method="post" action="/demo-issuer/sigma-offer" class="inline-form">
        <input type="hidden" name="type" value="<%= it.type %>">
        <div class="field">
          <label for="su-<%= it.type %>"><%= t('att.' + it.type + '.name') %> – <%= t('issuer.console.sigma_user') %></label>
          <select id="su-<%= it.type %>" name="identifier">
            <% it.users.forEach(function (u) { %><option value="<%= u.identifier %>"><%= u.label %> (<%= u.identifier %>)</option><% }) %>
          </select>
        </div>
        <details class="raw">
          <summary><%= t('issuer.console.sigma_advanced') %></summary>
          <p class="note"><%= t('issuer.console.sigma_advanced_hint') %></p>
          <div class="field"><label for="ci-<%= it.type %>"><%= t('issuer.console.sigma_custom_id') %></label><input id="ci-<%= it.type %>" name="customIdentifier" type="text" maxlength="64" autocomplete="off" spellcheck="false"></div>
          <div class="field"><label for="cc-<%= it.type %>"><%= t('issuer.console.sigma_custom_cred') %></label><input id="cc-<%= it.type %>" name="customCredentialIdentifier" type="text" maxlength="64" autocomplete="off" spellcheck="false"></div>
        </details>
        <button class="btn" type="submit"><%= t('issuer.console.sigma_btn') %><span class="sr-only"> – <%= t('att.' + it.type + '.name') %></span></button>
      </form>
    <% }) %>
    <p class="note"><%= t('issuer.console.sigma_note') %></p>
  </section>
  <% } %>
  <p class="note"><%= t('issuer.console.note') %></p>
</div>
<%- include('../partials/foot') %>
