<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body style="--theme: <%= themeColor %>;">
<% if (mockMode) { %>
  <div class="mock-banner" role="status">MOCK MODE – simulated wallet and Issuer. Not connected to SIGMA. All data is fake.</div>
<% } %>
<header class="site-header">
  <a class="brand" href="<%= rp ? basePath + '/' : '/' %>">
    <span class="logo" aria-hidden="true"><%= rp ? rp.displayName.replace(/^Demo /, '').charAt(0) : 'Σ' %></span>
    <span class="brand-name"><%= rp ? rp.displayName : 'SIGMA Demo RPs' %></span>
  </a>
  <nav><% if (rp) { %><a href="/">All demos</a><% } %></nav>
</header>
<main class="container">
