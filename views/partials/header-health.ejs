<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/health/"><img class="brand-logo" src="/img/rp-health.svg" alt="" width="42" height="42"><span class="brand-name">Demo Health</span></a>
    <nav aria-label="<%= t('nav.main') %>">
      <ul class="nav-list">
        <li><a href="/health/"><%= t('nav.home') %></a></li>
        <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
          <li><a href="/health/portal"><%= t('health.nav.portal') %></a></li>
          <li><form method="post" action="/health/signout"><button class="link-btn" type="submit"><%= t('btn.signout') %></button></form></li>
        <% } else { %>
          <li><a class="btn btn-small" href="/health/login"><%= t('health.nav.login') %></a></li>
        <% } %>
        <li><a href="/"><%= t('nav.all_demos') %></a></li>
      </ul>
    </nav>
    <%- include('lang') %>
  </div>
</header>
