<header class="site-header">
  <div class="wrap header-inner">
    <div class="brand-group">
      <a class="brand brand-in" href="/"><img src="/img/in-groupe-logo.svg" alt="<%= brand.name %>" width="112" height="54"></a>
      <span class="brand-sub"><%= t('dash.short') %></span>
    </div>
    <div class="header-tools">
      <nav aria-label="<%= t('nav.main') %>">
        <ul class="nav-list">
          <li><a href="/demo-issuer"><%= t('nav.issuer') %></a></li>
          <% if (mockMode) { %><li><a href="/wallet"><%= t('nav.wallet') %></a></li><% } %>
        </ul>
      </nav>
      <%- include('lang') %>
    </div>
  </div>
</header>
