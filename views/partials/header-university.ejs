<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/university/"><img class="brand-logo" src="/img/rp-university.svg" alt="" width="42" height="42"><span class="brand-name">Demo University</span></a>
    <nav aria-label="<%= t('nav.main') %>">
      <ul class="nav-list">
        <li><a href="/university/"><%= t('nav.home') %></a></li>
        <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
          <li><a href="/university/exams"><%= t('uni.nav.exams') %></a></li>
          <li><form method="post" action="/university/signout"><button class="link-btn" type="submit"><%= t('btn.signout') %></button></form></li>
        <% } else { %>
          <li><a href="/university/login"><%= t('uni.nav.login') %></a></li>
        <% } %>
        <li><a href="/"><%= t('nav.all_demos') %></a></li>
      </ul>
    </nav>
    <%- include('lang') %>
  </div>
</header>
