<!doctype html>
<html lang="<%= locale %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> – <%= rp ? rp.displayName : brand.name + ' ' + t('dash.short') %></title>
<link rel="stylesheet" href="/css/fonts.css?v=<%= v %>">
<link rel="stylesheet" href="/css/base.css?v=<%= v %>">
<link rel="stylesheet" href="/css/<%= skin %>.css?v=<%= v %>">
<link rel="icon" href="/img/favicon.svg?v=<%= v %>" type="image/svg+xml">
</head>
<body class="skin-<%= skin %>">
<a class="skip-link" href="#main"><%= t('skip') %></a>
<% if (mockMode) { %>
<div class="mock-banner" role="status"><strong><%= t('mock.label') %></strong> <%= t('mock.banner') %></div>
<% } %>
<% if (skin !== 'dashboard') { %><%- include('brand-bar') %><% } %>
<%- include('header-' + skin) %>
<main id="main" tabindex="-1">
<% if (flash) { %><div class="alert alert-success" role="status"><%= t(flash) %></div><% } %>
