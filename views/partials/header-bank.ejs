<div class="utility-bar"><div class="wrap utility-inner">
  <span><%= t('bank.util.private') %></span><span><%= t('bank.util.business') %></span>
  <span class="spacer"></span>
  <a href="/"><%= t('nav.all_demos') %></a>
  <%- include('lang') %>
</div></div>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/bank/"><img class="brand-logo" src="/img/rp-bank.svg" alt="" width="42" height="42"><span class="brand-name">Demo Bank</span></a>
    <nav aria-label="<%= t('nav.main') %>">
      <ul class="nav-list">
        <li><a href="/bank/"><%= t('nav.home') %></a></li>
        <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
          <li><a href="/bank/account"><%= t('bank.nav.account') %></a></li>
          <li><form method="post" action="/bank/signout"><button class="link-btn" type="submit"><%= t('btn.signout') %></button></form></li>
        <% } else { %>
          <li><a class="btn btn-small" href="/bank/login"><%= t('bank.nav.login') %></a></li>
        <% } %>
      </ul>
    </nav>
  </div>
</header>
