<%- include('partials/head') %>
<div class="wrap narrow">
  <h1><%= t('verify.title') %></h1>
  <p class="lead"><%= t('verify.intro', { rp: tx.rpName }) %></p>

  <section class="panel" aria-labelledby="req-h">
    <h2 id="req-h"><%= t('verify.requested') %></h2>
    <% tx.reqs.forEach(function (rq) { %>
      <h3><%= t('att.' + rq.type + '.name') %></h3>
      <ul class="tags">
        <% rq.claims.forEach(function (c) { %><li><%= t('claim.' + c) %></li><% }) %>
      </ul>
    <% }) %>
    <p class="note"><%= t('verify.minimal') %></p>
  </section>

  <section class="panel handoff" aria-labelledby="scan-h">
    <h2 id="scan-h"><%= t('verify.scan') %></h2>
    <div class="handoff-grid">
      <div class="handoff-mobile">
        <p><%= t('verify.mobile') %></p>
        <p><a class="btn btn-large" href="<%= link %>"><%= t('verify.open_wallet') %></a></p>
      </div>
      <div class="handoff-desktop">
        <p><%= t('verify.desktop') %></p>
        <img class="qr" src="<%= qr %>" width="260" height="260" alt="<%= t('verify.qr_alt') %>">
      </div>
    </div>
    <details class="raw">
      <summary><%= t('verify.show_link') %></summary>
      <p><code class="break"><%= link %></code></p>
    </details>
  </section>

  <div id="verify-status" class="alert alert-info" role="status" aria-live="polite"
       data-status-url="<%= statusUrl %>" data-finish-url="<%= finishUrl %>"
       data-msg-waiting="<%= t('verify.waiting') %>" data-msg-done="<%= t('verify.received') %>">
    <%= t('verify.waiting') %>
  </div>
  <noscript>
    <p><%= t('verify.noscript') %></p>
    <p><a class="btn" href="<%= finishUrl %>"><%= t('verify.noscript_btn') %></a></p>
  </noscript>
  <p class="note"><%= t('verify.expires', { time: new Intl.DateTimeFormat(locale, { timeStyle: 'short' }).format(expiresAt) }) %></p>

  <% if (walletUrl) { %>
  <section class="panel panel-mock" aria-labelledby="sim-h">
    <h2 id="sim-h"><%= t('mockw.badge') %></h2>
    <p><%= t('verify.sim_intro') %></p>
    <p><a class="btn btn-secondary" href="<%= walletUrl %>"><%= t('verify.sim_open') %></a></p>
  </section>
  <% } %>

  <p><a href="/<%= rp.id %>/"><%= t("btn.cancel") %></a></p>
</div>
<script src="/js/verify-poll.js?v=<%= v %>" defer></script>
<%- include('partials/foot') %>
