<%- include('partials/head') %>
<section class="hero">
  <div class="wrap">
    <h1><%= t('dash.title') %></h1>
    <p class="lead"><%= t('dash.subtitle') %></p>
    <ul class="chips" aria-label="<%= t('dash.status') %>">
      <li class="chip <%= mockMode ? 'chip-warn' : 'chip-ok' %>"><%= mockMode ? t('dash.mode.mock') : t('dash.mode.live') %></li>
      <li class="chip"><%= issuerMode === 'local' ? t('dash.issuer.local') : t('dash.issuer.external') %></li>
      <li class="chip"><%= multiCredential ? t('dash.multi.on') : t('dash.multi.off') %></li>
      <% if (trustAny) { %><li class="chip chip-warn"><%= t('dash.trust.any') %></li><% } %>
    </ul>
  </div>
</section>
<div class="wrap">
  <section aria-labelledby="rps-h">
    <h2 id="rps-h"><%= t('dash.rps') %></h2>
    <ul class="cards">
      <% rps.forEach(function (r) { %>
        <li class="card card-<%= r.id %>">
          <img class="card-logo" src="/img/rp-<%= r.id %>.svg" alt="" width="56" height="56">
          <h3><a class="card-link" href="/<%= r.id %>/"><%= r.displayName %></a></h3>
          <p><%= t('rp.' + r.id + '.desc') %></p>
          <p class="card-meta"><%= t('rp.' + r.id + '.uses') %></p>
          <span class="card-cta" aria-hidden="true"><%= t('dash.open') %> →</span>
        </li>
      <% }) %>
    </ul>
  </section>

  <section aria-labelledby="how-h" class="panel">
    <h2 id="how-h"><%= t('dash.how.title') %></h2>
    <ol class="steps">
      <li><%= t('dash.how.1') %></li>
      <li><%= t('dash.how.2') %></li>
      <li><%= t('dash.how.3') %></li>
    </ol>
  </section>

  <% if (sigma) { %>
  <section aria-labelledby="sg-h" class="panel">
    <h2 id="sg-h"><%= t('dash.sigma.title') %></h2>
    <% if (!sigma.summary.reachable) { %>
      <p class="alert alert-warn" role="note"><%= t('dash.sigma.unreachable') %> <code class="break"><%= sigma.url %></code></p>
    <% } else { %>
      <p><%= t('dash.sigma.desc') %> <code class="break"><%= sigma.summary.issuer %></code></p>
      <% if (issuerMode === 'local') { %><p class="note"><%= t('dash.sigma.mode_local') %></p><% } %>
      <table class="table table-fixed">
        <caption class="sr-only"><%= t('dash.sigma.title') %></caption>
        <thead><tr><th scope="col"><%= t('dash.sigma.col.att') %></th><th scope="col"><%= t('dash.sigma.col.config') %></th><th scope="col"><%= t('dash.sigma.col.status') %></th></tr></thead>
        <tbody>
        <% sigma.rows.forEach(function (row) { %>
          <tr>
            <td><%= t('att.' + row.key + '.name') %></td>
            <td><% if (row.config) { %><code class="break"><%= row.config.id %></code> <span class="note">(<%= row.config.format %>)</span><% } else { %>—<% } %></td>
            <td><%= row.config ? t('dash.sigma.ok') : t('dash.sigma.fallback') %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
  <% } %>

  <section aria-labelledby="iss-h" class="panel">
    <h2 id="iss-h"><%= t('dash.issuer.title') %></h2>
    <p><%= t('dash.issuer.desc') %></p>
    <dl class="meta">
      <dt><%= t('dash.issuer.id') %></dt><dd><code><%= issuerUrl %></code></dd>
      <dt><%= t('dash.issuer.metadata') %></dt><dd><a href="/.well-known/openid-credential-issuer/issuer"><code>/.well-known/openid-credential-issuer/issuer</code></a></dd>
    </dl>
    <p><a class="btn" href="/demo-issuer"><%= t('dash.issuer.cta') %></a>
    <% if (mockMode) { %> <a class="btn btn-secondary" href="/wallet"><%= t('nav.wallet') %></a><% } %></p>
  </section>
</div>
<%- include('partials/foot') %>
