<%- include('partials/header') %>
<section class="panel wallet">
  <p class="badge">SIMULATED WALLET – not a real EUDI Wallet</p>
  <h1><%= rp.displayName %> requests <%= presentation.label %></h1>
  <p>In live mode the Intermediary shows an OID4VP QR code / deeplink here. This page stands in for the wallet and returns <strong>fake</strong> data.</p>
  <dl class="meta">
    <dt>scope</dt><dd><code><%= presentation.scope %></code></dd>
    <dt>acr_values</dt><dd><code><%= presentation.acrValues %></code></dd>
  </dl>
  <h2>Data that will be shared</h2>
  <table class="claims">
    <% Object.entries(claims).forEach(function (e) { if (e[0] === 'sub' || e[0] === 'mock') return; %>
      <tr><th><%= e[0] %></th><td><%= typeof e[1] === 'object' ? JSON.stringify(e[1]) : e[1] %></td></tr>
    <% }) %>
  </table>
  <div class="actions">
    <form method="post" action="<%= basePath %>/mock-wallet/approve"><input type="hidden" name="state" value="<%= state %>"><button class="btn" type="submit">Approve and share</button></form>
    <form method="post" action="<%= basePath %>/mock-wallet/decline"><input type="hidden" name="state" value="<%= state %>"><button class="btn secondary" type="submit">Decline</button></form>
  </div>
</section>
<%- include('partials/footer') %>
