<%- include('../partials/head') %>
<div class="wrap narrow">
  <p class="crumbs"><a href="/jobs/"><%= t('jobs.nav.jobs') %></a> › <%= t('jobs.' + j.id + '.title') %></p>
  <h1><%= t('jobs.' + j.id + '.title') %></h1>
  <p class="lead"><%= j.company %> · <%= j.city %></p>
  <section class="panel" aria-labelledby="jd-h">
    <h2 id="jd-h"><%= t('jobs.about') %></h2>
    <p><%= t('jobs.' + j.id + '.desc') %></p>
    <dl class="meta"><dt><%= t('jobs.requires') %></dt><dd><%= t('jobs.level.' + j.eqf) %></dd></dl>
  </section>
  <p><a class="btn btn-large" href="/jobs/apply/<%= j.id %>"><%= t('jobs.apply.btn') %></a></p>
  <% if (!loggedIn) { %><p class="note"><%= t('jobs.apply.account_note') %></p><% } %>
</div>
<%- include('../partials/foot') %>
