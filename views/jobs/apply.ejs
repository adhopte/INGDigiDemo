<%- include('../partials/head') %>
<div class="wrap narrow">
  <h1><%= t('jobs.apply.title', { job: t('jobs.' + j.id + '.title') }) %></h1>
  <p class="lead"><%= j.company %> · <%= j.city %> · <%= t('jobs.requires') %>: <%= t('jobs.level.' + j.eqf) %></p>
  <section class="panel" aria-labelledby="rv-h">
    <h2 id="rv-h"><%= t('jobs.apply.review') %></h2>
    <dl class="meta">
      <dt><%= t('jobs.done.candidate') %></dt><dd><%= p.given_name %> <%= p.family_name %> <span class="verified"><span aria-hidden="true">✔ </span><%= t('jobs.cv.pid_verified') %></span></dd>
      <dt><%= t('jobs.done.cv') %></dt><dd><% if (cv) { %><%= cv.name %> (<%= Math.max(1, Math.round(cv.size / 1000)) %> KB)<% } else { %><span class="note"><%= t('jobs.apply.cv_none') %></span><% } %></dd>
      <dt><%= t('jobs.done.education') %></dt>
      <dd>
        <% if (!edu.length) { %><span class="meets-no"><%= t('jobs.apply.warn_diploma') %></span> <a href="/jobs/cv/diploma"><%= t('jobs.apply.add_now') %></a>
        <% } else { %>
          <ul class="plain"><% edu.forEach(function (e) { %><li><%= e.title %>, <%= e.institution %> <span class="verified"><span aria-hidden="true">✔ </span><%= t('jobs.done.verified') %></span></li><% }) %></ul>
          <% if (meets === true) { %><span class="meets-ok"><span aria-hidden="true">✔ </span><%= t('jobs.done.meets') %></span><% } else if (meets === false) { %><span class="meets-no"><%= t('jobs.done.below') %></span><% } %>
        <% } %>
      </dd>
    </dl>
    <p class="note"><a href="/jobs/cv"><%= t('jobs.nav.cv') %></a></p>
  </section>
  <form method="post" action="/jobs/apply/<%= j.id %>"><button class="btn btn-large" type="submit"><%= t('jobs.apply.send') %></button></form>
  <p class="note"><%= t('jobs.done.note') %></p>
</div>
<%- include('../partials/foot') %>
