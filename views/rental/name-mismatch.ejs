<%- include('../partials/head') %>
<div class="wrap">
  <div class="alert alert-warn" role="alert"><strong><%= t('rental.mismatch.title') %></strong></div>
  <h1><%= t('rental.mismatch.title') %></h1>
  <p class="lead"><%= t('rental.mismatch.intro') %></p>
  <section class="panel" aria-labelledby="mm-h">
    <h2 id="mm-h"><%= t('rental.mismatch.compare') %></h2>
    <dl class="meta">
      <dt><%= t('rental.mismatch.licence') %></dt><dd><%= licenceName %></dd>
      <dt><%= t('rental.mismatch.payment') %></dt><dd><%= holder %></dd>
    </dl>
  </section>
  <p><strong><%= t('rental.mismatch.question') %></strong></p>
  <div class="actions">
    <form method="post" action="/rental/confirmation/proceed" class="inline-form"><button class="btn btn-large" type="submit"><%= t('rental.mismatch.proceed') %></button></form>
    <form method="post" action="/rental/confirmation/cancel" class="inline-form"><button class="btn btn-large btn-secondary" type="submit"><%= t('rental.mismatch.cancel') %></button></form>
  </div>
</div>
<%- include('../partials/foot') %>
