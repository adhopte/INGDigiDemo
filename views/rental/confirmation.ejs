<%- include('../partials/head') %>
<div class="wrap">
  <div class="alert alert-success" role="status"><strong><%= t('rental.confirm.title') %></strong></div>
  <h1><%= t('rental.confirm.thanks', { name: c.given_name || c.family_name }) %></h1>
  <section class="panel" aria-labelledby="sum-h">
    <h2 id="sum-h"><%= t('rental.confirm.summary') %></h2>
    <dl class="meta">
      <dt><%= t('rental.confirm.ref') %></dt><dd class="mono"><%= d.ref %></dd>
      <dt><%= t('rental.form.car') %></dt><dd><%= t('rental.car.' + car.id) %></dd>
      <dt><%= t('rental.confirm.pickup') %></dt><dd><%= fmtDate(d.pickup) %></dd>
      <dt><%= t('rental.confirm.return') %></dt><dd><%= fmtDate(d.back) %></dd>
      <dt><%= t('rental.form.days') %></dt><dd><%= d.days %></dd>
      <dt><%= t('rental.driver.name') %></dt><dd><%= d.driver %></dd>
      <dt><%= t('claim.document_number') %></dt><dd class="mono"><%= d.licence %></dd>
      <dt><%= t('rental.confirm.total') %></dt><dd><strong><%= fmtMoney(d.total) %></strong></dd>
      <dt><%= t('rental.confirm.paid_by') %></dt><dd><span class="mono"><%= d.ibanMasked %></span> (<%= d.bank %>)</dd>
    </dl>
    <p class="note"><%= t('rental.confirm.note') %></p>
  </section>
  <p><a class="btn btn-secondary" href="/rental/booking"><%= t('rental.confirm.again') %></a></p>
</div>
<%- include('../partials/foot') %>
