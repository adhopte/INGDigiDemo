# Copy to .env for local development. NEVER commit real values (.env is git-ignored).

# --- General ---
NODE_ENV=development
PORT=3000
# Public URL of this app. Wallet-facing URLs (request_uri, response_uri, issuer identifier) are built from it.
# On Render it defaults to RENDER_EXTERNAL_URL. A real wallet needs a public HTTPS URL (use a tunnel when running locally).
PUBLIC_BASE_URL=http://localhost:3000
# Long random string (openssl rand -hex 32). Required in production.
SESSION_SECRET=change-me

# --- Demo modes ---
# true = simulated wallet (no real wallet needed), clearly flagged in the UI. false = real EU Wallet only.
MOCK_MODE=true
# University: true = one request for PID + birth certificate, false = two requests in a row
MULTI_CREDENTIAL=false

# --- OpenID4VP verifier ---
# x509_hash (default, HAIP) | x509_san_dns | redirect_uri (unsigned, by value)
VP_CLIENT_ID_SCHEME=x509_hash
# direct_post.jwt (default, response encrypted to a per-request key; required by HAIP wallets) | direct_post
VP_RESPONSE_MODE=direct_post.jwt
# dcql (OpenID4VP 1.0) | pex (DIF Presentation Exchange, older wallets)
VP_QUERY_LANGUAGE=dcql
VP_DEEPLINK_BASE=openid4vp://authorize
# Expose GET /vp/diagnostics (recent verifier events: wallet capabilities, rejection reasons; no claim values)
DIAGNOSTICS_ENDPOINT=true
# Issuers whose PIDs / credentials are accepted besides the local demo issuer: comma-separated issuer URLs
# (their keys are fetched from <iss>/.well-known/jwt-vc-issuer). '*' = any issuer, development only.
TRUSTED_ISSUERS=
# DEMO ONLY: accept credentials from any issuer (signature still checked against the credential's own key/certificate).
TRUST_ANY_ISSUER=false
# Alternatively trust x5c chains anchored in these PEM roots (use \n for newlines)
TRUSTED_CA_PEM=
# Verifier identity for signed request objects. Empty = a self-signed demo certificate is generated at startup.
# Key: `npm run keygen`. Chain: certificate whose SAN dNSName is the host of PUBLIC_BASE_URL, chained to a root the wallet trusts.
VERIFIER_SIGNING_KEY_JWK=
VERIFIER_CERT_CHAIN_PEM=

# --- Attestation issuer ---
# local = built-in OpenID4VCI issuer (pre-authorised code, SD-JWT VC) | external = your Issuer's backend API
ISSUER_MODE=local
# local issuer: require a 4-digit tx_code
ISSUER_TX_CODE=false
# local issuer signing key (private ES256 JWK, `npm run keygen`). Empty = ephemeral key regenerated at each start.
ISSUER_SIGNING_KEY_JWK=

# external issuer (ISSUER_MODE=external) – see src/issuer/external.ts (assumed API, must be confirmed)
ISSUER_API_BASE_URL=https://issuer.example.com
ISSUER_EXTERNAL_OFFER_PATH=/credential-offers
# none | bearer | client_credentials
ISSUER_EXTERNAL_AUTH=none
ISSUER_EXTERNAL_TOKEN_URL=
ISSUER_EXTERNAL_RESPONSE_URI_FIELD=credential_offer_uri
ISSUER_API_TOKEN=
ISSUER_CLIENT_ID=
ISSUER_CLIENT_SECRET=

# --- Credential configuration overrides (defaults live in config/rps.json) ---
# Pattern: ATTESTATION_<KEY>_CONFIG_ID, ATTESTATION_<KEY>_VCT, ATTESTATION_<KEY>_ACCEPTED_VCT (comma list)
# KEY = PID | ACCOUNT | PAYMENT | BIRTH_CERTIFICATE
#ATTESTATION_PID_CONFIG_ID=
#ATTESTATION_PID_ACCEPTED_VCT=urn:eudi:pid:1,urn:eu.europa.ec.eudi:pid:1   (use * for any vct)
# Formats requested for the PID (default: both): dc+sd-jwt, mso_mdoc
#ATTESTATION_PID_FORMATS=dc+sd-jwt,mso_mdoc
# Override requested / minimum claims of a presentation: RP_<RP>_<PRESENTATION>_CLAIMS, RP_<RP>_<PRESENTATION>_MIN_CLAIMS
#RP_BANK_PID_MIN_CLAIMS=given_name,family_name,birthdate
#ATTESTATION_PAYMENT_CONFIG_ID=demo_bank_payment

# --- Branding overrides ---
#BRAND_PRIMARY=#0a2a5e
#BRAND_ACCENT=#006d77
