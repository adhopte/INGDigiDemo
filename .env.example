# Copy to .env for local development. NEVER commit real values.

# --- General ---
NODE_ENV=development
PORT=3000
# Public URL of this app. Redirect URIs are built from it: <PUBLIC_BASE_URL>/<rp>/callback
PUBLIC_BASE_URL=http://localhost:3000
# Long random string (e.g. `openssl rand -hex 32`). Required in production.
SESSION_SECRET=change-me

# --- Modes ---
# true = simulated wallet + fake Issuer offers; a yellow banner is shown in the UI
MOCK_MODE=true
# University: true = one request for PID + BC, false = two requests in a row
MULTI_CREDENTIAL=false

# --- SIGMA Wallet Intermediary (OIDC provider) ---
# Discovery: <INTERMEDIARY_ISSUER_URL>/.well-known/openid-configuration
INTERMEDIARY_ISSUER_URL=https://intermediary.example.com
# Token endpoint auth of the RP clients: basic (client_secret_basic, default) or post (client_secret_post)
OIDC_CLIENT_AUTH=basic

# Per-RP OIDC clients (client_id can be overridden here; secrets ONLY here)
RP_BANK_CLIENT_ID=
RP_BANK_CLIENT_SECRET=
RP_ESHOP_CLIENT_ID=
RP_ESHOP_CLIENT_SECRET=
RP_UNIVERSITY_CLIENT_ID=
RP_UNIVERSITY_CLIENT_SECRET=
RP_ELECTRICITY_CLIENT_ID=
RP_ELECTRICITY_CLIENT_SECRET=

# Optional overrides of config/rps.json, pattern:
#   RP_<RP>_<PRESENTATION>_SCOPE, RP_<RP>_<PRESENTATION>_ACR_VALUES, RP_<RP>_CRED_<ATTESTATION>
# e.g. RP_BANK_PID_SCOPE="openid pid"  RP_BANK_CRED_ACCOUNT=demo_bank_account

# --- SIGMA Issuer (credential offer API) ---
ISSUER_API_BASE_URL=https://issuer.example.com
ISSUER_CLIENT_ID=
ISSUER_CLIENT_SECRET=
