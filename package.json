{
  "name": "eu-wallet-rp-playground",
  "version": "1.0.0",
  "private": true,
  "description": "IN Groupe EU Wallet Relying Party Playground (dashboard + bank, eShop, university, electricity RPs + local OpenID4VCI issuer)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "a11y": "node scripts/a11y-check.mjs",
    "keygen": "node scripts/gen-keys.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@peculiar/x509": "^3.1.0",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "memorystore": "^1.6.8",
    "openid-client": "^6.8.9",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "axe-core": "^4.14.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
